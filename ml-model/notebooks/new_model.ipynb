   "source": [
    "### **Converting basic english labels into a group of 1 and 0 to get a array** "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "0d2e0c52",
   "metadata": {},
   "outputs": [],
   "source": [
    "emotion_labels = [\n",
    "    \"Fear\",\n",
    "    \"Anxiety\",\n",
    "    \"Panic\",\n",
    "    \"Distress\",\n",
    "    \"Urgency\",\n",
    "    \"Coercion\",\n",
    "    \"Aggression\",\n",
    "    \"Helplessness\",\n",
    "    \"Calm\",\n",
    "]\n",
    "\n",
    "def create_labels(examples):\n",
    "    examples[\"labels\"] = [\n",
    "        1.0* examples[label]\n",
    "        for label in emotion_labels\n",
    "    ]\n",
    "    return examples"
   ]
  },
